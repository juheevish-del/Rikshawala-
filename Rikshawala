<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desi Ambient Radio Clone</title>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: 'Courier New', Courier, monospace;
            text-align: center;
            padding: 50px 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
        /* Custom Ambient Illustration Container */
        .artwork-box {
            width: 100%;
            height: 300px;
            background: #252525; /* Replace with your image link */
            border: 3px solid #ff4500;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .controls button {
            background: #ff4500;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 16px;
            cursor: pointer;
            margin: 5px;
            font-weight: bold;
        }
        /* Completely hides the functional YouTube Player container */
        #hidden-player {
            position: absolute;
            left: -9999px;
            top: -9999px;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>CHAI STALL RADIO</h1>
    <p>Ambient retro beats running 24/7...</p>

    <div class="artwork-box">
        <!-- Put your background artwork illustration link here -->
        <span>[ Ambient Illustration Image Layer ]</span>
    </div>

    <div class="controls">
        <button onclick="playMusic()">PLAY</button>
        <button onclick="pauseMusic()">PAUSE</button>
        <button onclick="nextSong()">NEXT TRACK</button>
    </div>
</div>

<!-- Invisible functional YouTube target iframe element -->
<div id="hidden-player"></div>

<script>
    let player;
    
    // Load the official YouTube Iframe Player API asynchronously
    function onYouTubeIframeAPIReady() {
        player = new YT.Player('hidden-player', {
            height: '390',
            width: '640',
            playerVars: {
                // Replace this ID with your chosen custom public YouTube Playlist ID
                listType: 'playlist',
                list: 'PLDfKAXSi6kUZb5vWRE5m9E8SAtWbA6836', 
                autoplay: 0,
                controls: 0,
                disablekb: 1
            }
        });
    }

    function playMusic() { if(player) player.playVideo(); }
    function pauseMusic() { if(player) player.pauseVideo(); }
    function nextSong() { if(player) player.nextVideo(); }
</script>
<!-- Fetch base frame configurations directly from Google CDNs -->
<script src="https://youtube.com"></script>

</body>
</html>
